{
  "name": "phosphor-index",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desk": "vite --host 0.0.0.0 --open /desk.html",
    "build": "npm run check:catalog && tsc --noEmit && vite build",
    "build:desk": "tsc --noEmit && vite build --config vite.desk.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "preview:desk": "vite preview --host 0.0.0.0 --config vite.desk.config.ts",
    "test": "node --test tests/*.test.mjs",
    "check:catalog": "node scripts/validate-catalog.mjs && node scripts/build-manifest.mjs --check",
    "lint": "eslint . --ignore-pattern dist",
    "build:manifest": "node scripts/build-manifest.mjs",
    "enrich": "node scripts/enrich-catalog.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.1"
  },
  "type": "module"
}
